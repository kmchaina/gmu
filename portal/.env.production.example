# ---------------------------------------------------------------------------
# NIMR GMU — production environment template
#
# Copy to .env on the server, fill in the marked values, then run:
#   php artisan key:generate
#   php artisan config:clear
#   php artisan gmu:health          # must pass before go-live
#   php artisan gmu:mail-test coordinator@nimr.or.tz
#
# Never commit the filled-in file. Audit findings C1 and H8.
# ---------------------------------------------------------------------------

APP_NAME="NIMR GMU"
APP_ENV=production
APP_KEY=                                  # php artisan key:generate writes this
APP_DEBUG=false                           # never true on a shared server
APP_URL=https://gmu.nimr.or.tz            # the real hostname, with TLS

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Dar_es_Salaam

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning                         # debug leaks query contents

# ── Database ────────────────────────────────────────────────────────────────
# A scoped account, never root. Create with:
#   CREATE USER 'gmu_app'@'localhost' IDENTIFIED BY '<password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES
#     ON nimr_gmu.* TO 'gmu_app'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nimr_gmu
DB_USERNAME=gmu_app
DB_PASSWORD=                              # FILL IN

# ── Sessions and cache ──────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true                # requires HTTPS
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local                     # uploads stay off the public disk

# ── Mail ────────────────────────────────────────────────────────────────────
# Without this, deadline reminders and the weekly digest are written to a log
# file and never reach anyone (finding H8).
MAIL_MAILER=smtp
MAIL_HOST=                                # FILL IN — e.g. smtp.nimr.or.tz
MAIL_PORT=587
MAIL_USERNAME=                            # FILL IN
MAIL_PASSWORD=                            # FILL IN
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="gmu@nimr.or.tz"
MAIL_FROM_NAME="${APP_NAME}"

# ── GMU settings ────────────────────────────────────────────────────────────
GMU_ADMIN_EMAIL=admin@nimr.or.tz
GMU_ADMIN_PASSWORD=                       # leave blank to have one generated once
GMU_BASE_CURRENCY=USD

# SMS alerts to PIs in the field (slide 10). Leave the gateway as "null" until
# an account exists; messages are logged rather than silently lost.
GMU_SMS_GATEWAY=null
GMU_SMS_USERNAME=
GMU_SMS_KEY=
GMU_SMS_SENDER_ID=NIMR

# Optional AI assistance. Without a key the matching and risk engines still run
# on their rule-based scoring; only the written summaries are skipped.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
